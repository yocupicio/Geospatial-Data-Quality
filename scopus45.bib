@CONFERENCE{Faraoun202496,
	author = {Faraoun, El Moundir and Mellouli, Nédra and Millot, Stéphane and Lamolle, Myriam},
	title = {Contextual kNN Ensemble Retrieval Approach for Semantic Postal Address Matching},
	year = {2024},
	journal = {CEUR Workshop Proceedings},
	volume = {3770},
	pages = {96 - 111},
	url = {https://www.scopus.com/pages/publications/85207100919?origin=resultslist},
	affiliations = {LIASD Paris 8 University, 2 rue de la liberté, Saint-Denis, France; TEDIES, TALK Solutions, 45 Av. de Paris, Monéteau, France; ESILV DVRC, Léonard de Vinci Group, Léonard de Vinci Paris, La défense, 12 Av, France},
	abstract = {The biggest challenge today regarding courier services (delivery of small to medium-sized parcels) is the problem of Address Matching. With the expansion of geographical data and the diversity of formats in which it is received, traditional matching methods are becoming increasingly obsolete due to the lack of conformity of delivery information with postal address writing standards. These new constraints are affecting parcel delivery quality in terms of deliverables, cost and environmental impact. This research focuses on courier delivery data (i.e. postal addresses of recipients) in the context of matching French postal addresses. We introduce a new ensemble retrieval approach to the problem through a voting system leveraging multiple k-Nearest Neighbors search algorithms, called kNN-vote which effectively transform the Address Matching task to an Address Retrieval task. kNN-vote returns the top best normalized addresses similar to a given query (a non-normalized delivery address). The system takes advantage of several address representations, in particular Pre-trained Transformers-Based Sentence Embeddings. The system has been tested on a real database of French delivery addresses. The method meets high expectations, returning exactly matched addresses with a success rate of up to 96% in top 10 as well as 86% in top 1. © 2024 Copyright for this paper by its authors.},
	author_keywords = {Address matching or transport entity alignment; Address retrieval; Ensemble kNN retrieval models; Recipients/consignees identification or pairing; Recovery of recipients},
	keywords = {Nearest neighbor search; Postal services; Voting machines; Address matching or transport entity alignment; Address retrieval; Courier service; Ensemble kNN retrieval model; Geographical data; Matchings; Recipient/consignee identification or pairing; Recovery of recipient; Retrieval models; Service delivery; Semantics},
	correspondence_address = {E.M. Faraoun; LIASD Paris 8 University, Saint-Denis, 2 rue de la liberté, France; email: el.moundir.faraoun@gmail.com},
	editor = {Bunse M. and Lamarr Institute for Machine Learning and Artificial Intelligence, Joseph-von-Fraunhofer-Str. 25, Dortmund and Herde M. and University of Kassel, Intelligent Embedded Systems, Wilhelmshoher Allee 73, Kassel and Krempl G. and Lemaire V. and Tharwat A. and Hochschule Bielefeld, Kurt-Schumacher-Str. 6, Bielefeld and Pham M.T. and University of Kassel, Intelligent Embedded Systems, Wilhelmshoher Allee 73, Kassel and Saadallah A. and Lamarr Institute for Machine Learning and Artificial Intelligence, Joseph-von-Fraunhofer-Str. 25, Dortmund},
