	year = {2024},
	journal = {Data and Knowledge Engineering},
	volume = {153},
	pages = {},
	doi = {10.1016/j.datak.2024.102341},
	url = {https://www.scopus.com/pages/publications/85198960044?origin=resultslist},
	affiliations = {Dipartimento di Informatica, Sistemistica e Comunicazione, Università di Milano–Bicocca, Milan, Italy; GATE Institute, Sofia University “St. Kliment Ohridski”, Sofia, Bulgaria},
	abstract = {The ubiquitous availability of datasets has spurred the utilization of Artificial Intelligence methods and models to extract valuable insights, unearth hidden patterns, and predict future trends. However, the current process of data collection and linking heavily relies on expert knowledge and domain-specific understanding, which engenders substantial costs in terms of both time and financial resources. Therefore, streamlining the data acquisition, harmonization, and enrichment procedures to deliver high-fidelity datasets readily usable for analytics is paramount. This paper explores the capabilities of SemTUI, a comprehensive framework designed to support the enrichment of tabular data by leveraging semantics and user interaction. Utilizing SemTUI, an iterative and interactive approach is proposed to enhance the flexibility, usability and efficiency of geospatial data enrichment. The approach is evaluated through a pilot case study focused on urban planning, with a particular emphasis on geocoding. Using a real-world scenario involving the analysis of kindergarten accessibility within walking distance, the study demonstrates the proficiency of SemTUI in generating precise and semantically enriched location data. The incorporation of human feedback in the enrichment process successfully enhances the quality of the resulting dataset, highlighting SemTUI's potential for broader applications in geospatial analysis and its usability for users with limited expertise in manipulating geospatial data. © 2024 The Authors},
	author_keywords = {Data enrichment; Data integration; Data linking; Geocoding; Geospatial data enrichment; Semantic annotation; SemTUI (Semantic Table Interpretation); Tabular data; Urban planning},
	keywords = {Data acquisition; Iterative methods; Quality control; Semantics; Urban planning; Data enrichments; Datalinking; Geo coding; Geo-spatial data; Geospatial data enrichment; Semantic annotations; Semantic tables; SemTUI (semantic table interpretation); Tabular data; Data integration},
