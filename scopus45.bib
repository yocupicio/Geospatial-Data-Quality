	title = {Geocoding of epidemiological data: a case study comparing traditional APIs and Large Language Models (LLM)},
	year = {2025},
	journal = {2025 Latin American GRSS and ISPRS Remote Sensing Conference, LAGIRS 2025 - Proceedings},
	pages = {},
